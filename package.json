{
  "name": "particles",
  "description": "Test Project: WebGPU Particle System",
  "version": "1.0.0",
  "type": "module",
  "main": "dist/main.js",
  "private": true,
  "author": {
    "name": "Andreas Friedel"
  },
  "scripts": {
    "predev": "rimraf dist",
    "dev": "vite",
    "prebuild": "rimraf dist",
    "build": "vite build && tsc src/main.ts --outDir dist --target es2024 --module esnext --moduleResolution bundler",
    "prepreview": "yarn run build",
    "preview": "electron .",
    "prepackage": "rimraf dist_electron",
    "package": "yarn run build && electron-builder",
    "errorcheck": "tsc --noEmit",
    "lint": "eslint",
    "clean": "rimraf dist dist_electron"
  },
  "dependencies": {},
  "devDependencies": {
    "@stylistic/eslint-plugin": "5.8.0",
    "@typescript-eslint/eslint-plugin": "8.56.0",
    "@typescript-eslint/parser": "8.56.0",
    "@types/node": "22.15.12",
    "@webgpu/types": "0.1.69",
    "electron": "41.0.0",
    "electron-builder": "26.8.1",
    "eslint": "9.39.2",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "rimraf": "6.1.3",
    "typescript": "5.9.3",
    "vite": "7.3.1"
  },
  "resolutions": {
    "glob": "^13.0.0",
    "global-agent": "^4.1.2"
  },
  "build": {
    "appId": "com.particles.app",
    "productName": "WebGPU Particles",
    "directories": {
      "output": "dist_electron"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "win": {
      "target": "portable",
      "icon": "public/assets/favicon.ico"
    }
  }
}
